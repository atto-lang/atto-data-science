import class TestCase, TestSuite, TestOptions, RunSummary, TestOutcome from '../vendor/oreslang/testing';
import fnc fail, expect_true, expect_near_float, run_suite, require_success from '../vendor/oreslang/testing';

import fnc sqrt from '../src/math/scalar';
import fnc sum, dot, mean, variance_population, variance_sample, minimum, maximum from '../src/math/reductions';
import fnc scale, normalize_l2 from '../src/math/vector';
import class DenseMatrixF64 from '../src/math/matrix';
import fnc matvec_into from '../src/math/matrix';
import fnc validate_matrix, matrix_index, matrix_get from '../src/math/matrix';
import class FloatColumn from '../src/data/columnar';
import fnc column_mean from '../src/data/columnar';
import class ParticleSetF64 from '../src/dop/soa';
import fnc kinetic_energy from '../src/dop/soa';

fnc test_sqrt_nine(): TestOutcome {
  val Result<float, String> result = sqrt(9.0);
  if result.is_err(); do
    return fail("sqrt(9) returned Err");
  fi
  return expect_near_float(result.unwrap(), 3.0, 0.000001, "sqrt(9) must be 3");
}

fnc test_sqrt_negative(): TestOutcome {
  val Result<float, String> result = sqrt(0.0 - 1.0);
  return expect_true(result.is_err(), "sqrt(-1) must return Err");
}

fnc test_sum(): TestOutcome {
  val List<float> values = arr[1.0, 2.0, 3.0, 4.0];
  return expect_near_float(sum(values), 10.0, 0.000001, "sum must equal 10");
}

fnc test_mean(): TestOutcome {
  val List<float> values = arr[1.0, 2.0, 3.0, 4.0];
  val Result<float, String> result = mean(values);
  if result.is_err(); do
    return fail("mean returned Err");
  fi
  return expect_near_float(result.unwrap(), 2.5, 0.000001, "mean must equal 2.5");
}

fnc test_mean_empty(): TestOutcome {
  val List<float> values = arr[];
  val Result<float, String> result = mean(values);
  return expect_true(result.is_err(), "empty mean must return Err");
}

fnc test_variance(): TestOutcome {
  val List<float> values = arr[1.0, 2.0, 3.0, 4.0];
  val Result<float, String> population = variance_population(values);
  if population.is_err(); do
    return fail("population variance returned Err");
  fi

  val TestOutcome population_check = expect_near_float(
    population.unwrap(),
    1.25,
    0.000001,
    "population variance must equal 1.25"
  );
  if !population_check.passed; do
    return population_check;
  fi

  val Result<float, String> sample = variance_sample(values);
  if sample.is_err(); do
    return fail("sample variance returned Err");
  fi

  return expect_near_float(
    sample.unwrap(),
    1.6666666666666667,
    0.000001,
    "sample variance must equal 5/3"
  );
}

fnc test_dot_and_shape_error(): TestOutcome {
  val List<float> left = arr[1.0, 2.0, 3.0];
  val List<float> right = arr[4.0, 5.0, 6.0];
  val Result<float, String> result = dot(left, right);
  if result.is_err(); do
    return fail("dot returned Err for equal shapes");
  fi

  val TestOutcome value_check = expect_near_float(
    result.unwrap(),
    32.0,
    0.000001,
    "dot product must equal 32"
  );
  if !value_check.passed; do
    return value_check;
  fi

  val List<float> short = arr[1.0];
  val Result<float, String> mismatch = dot(left, short);
  return expect_true(mismatch.is_err(), "dot must reject shape mismatch");
}

fnc test_min_max(): TestOutcome {
  val List<float> values = arr[8.0, 0.0 - 4.0, 3.0, 11.0];

  val Result<float, String> min_result = minimum(values);
  if min_result.is_err(); do
    return fail("minimum returned Err");
  fi
  val TestOutcome min_check = expect_near_float(
    min_result.unwrap(),
    0.0 - 4.0,
    0.000001,
    "minimum must equal -4"
  );
  if !min_check.passed; do
    return min_check;
  fi

  val Result<float, String> max_result = maximum(values);
  if max_result.is_err(); do
    return fail("maximum returned Err");
  fi
  return expect_near_float(max_result.unwrap(), 11.0, 0.000001, "maximum must equal 11");
}

fnc test_scale_and_normalize(): TestOutcome {
  val List<float> source = arr[1.0, 2.0, 3.0];
  val List<float> scaled = scale(source, 2.0);
  val TestOutcome scale_check = expect_near_float(
    sum(scaled),
    12.0,
    0.000001,
    "scale must double the vector sum"
  );
  if !scale_check.passed; do
    return scale_check;
  fi

  val Result<List<float>, String> normalized = normalize_l2(scaled);
  if normalized.is_err(); do
    return fail("normalize_l2 returned Err");
  fi

  val List<float> unit = normalized.unwrap();
  val Result<float, String> norm_squared = dot(unit, unit);
  if norm_squared.is_err(); do
    return fail("dot failed for normalized vector");
  fi

  return expect_near_float(norm_squared.unwrap(), 1.0, 0.000001, "normalized vector must have unit norm");
}

fnc test_matvec(): TestOutcome {
  val DenseMatrixF64 matrix = new DenseMatrixF64(
    2,
    2,
    arr[1.0, 2.0, 3.0, 4.0]
  );
  val List<float> vector = arr[5.0, 6.0];
  val List<float> output = arr[0.0, 0.0];

  val Result<List<float>, String> result = matvec_into(matrix, vector, output);
  if result.is_err(); do
    return fail("matvec returned Err");
  fi

  val List<float> actual = result.unwrap();
  val TestOutcome first = expect_near_float(actual[0], 17.0, 0.000001, "matvec row 0");
  if !first.passed; do
    return first;
  fi

  return expect_near_float(actual[1], 39.0, 0.000001, "matvec row 1");
}

fnc test_matrix_bad_backing_storage(): TestOutcome {
  val DenseMatrixF64 truncated = new DenseMatrixF64(
    2, 2, arr[1.0]
  );
  val Result<float, String> result = matrix_get(truncated, 0, 1);
  return expect_true(result.is_err(), "matrix_get must reject short backing storage");
}

fnc test_matrix_valid_get(): TestOutcome {
  val DenseMatrixF64 matrix = new DenseMatrixF64(
    1, 1, arr[5.0]
  );
  val Result<float, String> result = matrix_get(matrix, 0, 0);
  if result.is_err(); do
    return fail("matrix_get rejected a valid 1x1 matrix");
  fi
  return expect_near_float(result.unwrap(), 5.0, 0.000001, "valid matrix element");
}

fnc test_matrix_shape_product_overflow(): TestOutcome {
  val DenseMatrixF64 huge = new DenseMatrixF64(
    3037000500, 3037000500, arr[]
  );
  val Result<bool, String> shape = validate_matrix(huge);
  if !shape.is_err(); do
    return fail("matrix shape multiplication overflow was accepted");
  fi
  val Result<int, String> index = matrix_index(huge, 0, 0);
  if !index.is_err(); do
    return fail("matrix index overflow was accepted");
  fi
  val Result<float, String> read_result = matrix_get(huge, 0, 0);
  return expect_true(read_result.is_err(), "matrix_get must reject overflowing shape");
}

fnc test_matrix_zero_extent_shape(): TestOutcome {
  // A zero extent is legal with empty storage even if the other extent
  // would overflow a nonzero shape product.
  val DenseMatrixF64 empty = new DenseMatrixF64(
    0, 3037000500, arr[]
  );
  val Result<bool, String> shape = validate_matrix(empty);
  if shape.is_err(); do
    return fail("zero-row matrix with empty storage must be valid");
  fi
  val Result<int, String> index = matrix_index(empty, 0, 0);
  return expect_true(index.is_err(), "zero-row matrix must have no readable rows");
}

fnc test_matrix_bounds_and_negative_shape(): TestOutcome {
  val DenseMatrixF64 valid = new DenseMatrixF64(1, 2, arr[1.0, 2.0]);
  val Result<int, String> negative_col = matrix_index(valid, 0, 0 - 1);
  if !negative_col.is_err(); do
    return fail("negative matrix column index must be rejected");
  fi
  val Result<int, String> beyond_rows = matrix_index(valid, 1, 0);
  if !beyond_rows.is_err(); do
    return fail("row equal to extent must be rejected");
  fi
  val Result<int, String> beyond_cols = matrix_index(valid, 0, 2);
  if !beyond_cols.is_err(); do
    return fail("column equal to extent must be rejected");
  fi
  val DenseMatrixF64 negative = new DenseMatrixF64(0 - 1, 2, arr[]);
  return expect_true(validate_matrix(negative).is_err(),
    "negative matrix extent must be rejected");
}

// Explicit empty-column matrix-vector multiplication must publish zeroes
// into the owned destination, never leave stale prior row values.
fnc test_matvec_zero_column_output(): TestOutcome {
  val DenseMatrixF64 empty_columns = new DenseMatrixF64(2, 0, arr[]);
  val List<float> vector = arr[];
  val List<float> output = arr[91.0, 92.0];
  val Result<List<float>, String> result = matvec_into(empty_columns, vector, output);
  if result.is_err(); do
    return fail("zero-column matrix-vector multiplication returned Err");
  fi
  val TestOutcome first = expect_near_float(output[0], 0.0, 0.000001,
    "zero-column matvec must zero the first row");
  if !first.passed; do
    return first;
  fi
  return expect_near_float(output[1], 0.0, 0.000001,
    "zero-column matvec must zero the second row");
}

fnc test_matvec_short_matrix_preflight(): TestOutcome {
  val DenseMatrixF64 short = new DenseMatrixF64(2, 2, arr[1.0]);
  val List<float> vector = arr[3.0, 4.0];
  val List<float> output = arr[91.0, 92.0];
  val Result<List<float>, String> result = matvec_into(short, vector, output);
  if !result.is_err(); do
    return fail("matvec accepted truncated matrix storage");
  fi
  val TestOutcome first = expect_near_float(output[0], 91.0, 0.000001,
    "short matrix rejection must preserve first destination element");
  if !first.passed; do
    return first;
  fi
  return expect_near_float(output[1], 92.0, 0.000001,
    "short matrix rejection must preserve second destination element");
}

fnc test_matvec_short_vector_preflight(): TestOutcome {
  val DenseMatrixF64 matrix = new DenseMatrixF64(
    2, 2, arr[1.0, 2.0, 3.0, 4.0]
  );
  val List<float> vector = arr[1.0];
  val List<float> output = arr[91.0, 92.0];
  val Result<List<float>, String> result = matvec_into(matrix, vector, output);
  if !result.is_err(); do
    return fail("matvec accepted truncated vector storage");
  fi
  val TestOutcome first = expect_near_float(output[0], 91.0, 0.000001,
    "short vector rejection must preserve first destination element");
  if !first.passed; do
    return first;
  fi
  return expect_near_float(output[1], 92.0, 0.000001,
    "short vector rejection must preserve second destination element");
}

fnc test_nullable_column_mean(): TestOutcome {
  val FloatColumn column = new FloatColumn(
    "x",
    arr[1.0, 100.0, 3.0],
    arr[true, false, true]
  );

  val Result<float, String> result = column_mean(column);
  if result.is_err(); do
    return fail("column_mean returned Err");
  fi

  return expect_near_float(result.unwrap(), 2.0, 0.000001, "column mean must ignore invalid values");
}

fnc test_particle_energy(): TestOutcome {
  val ParticleSetF64 particles = new ParticleSetF64(
    arr[0.0],
    arr[0.0],
    arr[0.0],
    arr[3.0],
    arr[4.0],
    arr[0.0],
    arr[2.0]
  );

  val Result<float, String> result = kinetic_energy(particles);
  if result.is_err(); do
    return fail("kinetic_energy returned Err");
  fi

  return expect_near_float(result.unwrap(), 25.0, 0.000001, "kinetic energy must equal 25");
}

pub routine main(): void {
  val TestSuite suite = new TestSuite(
    "data-science",
    arr[
      new TestCase("math/sqrt/nine", test_sqrt_nine, false, ""),
      new TestCase("math/sqrt/negative", test_sqrt_negative, false, ""),
      new TestCase("reductions/sum", test_sum, false, ""),
      new TestCase("reductions/mean", test_mean, false, ""),
      new TestCase("reductions/mean-empty", test_mean_empty, false, ""),
      new TestCase("reductions/variance", test_variance, false, ""),
      new TestCase("reductions/dot-shape", test_dot_and_shape_error, false, ""),
      new TestCase("reductions/min-max", test_min_max, false, ""),
      new TestCase("vector/scale-normalize", test_scale_and_normalize, false, ""),
      new TestCase("matrix/matvec", test_matvec, false, ""),
      new TestCase("matrix/short-storage", test_matrix_bad_backing_storage, false, ""),
      new TestCase("matrix/valid-get", test_matrix_valid_get, false, ""),
      new TestCase("matrix/overflow", test_matrix_shape_product_overflow, false, ""),
      new TestCase("matrix/zero-extent", test_matrix_zero_extent_shape, false, ""),
      new TestCase("matrix/bounds-and-negative", test_matrix_bounds_and_negative_shape, false, ""),
      new TestCase("matrix/zero-column-matvec", test_matvec_zero_column_output, false, ""),
      new TestCase("matrix/short-matrix-preflight", test_matvec_short_matrix_preflight, false, ""),
      new TestCase("matrix/short-vector-preflight", test_matvec_short_vector_preflight, false, ""),
      new TestCase("columnar/nullable-mean", test_nullable_column_mean, false, ""),
      new TestCase("dop/particle-energy", test_particle_energy, false, "")
    ]
  );

  val TestOptions options = new TestOptions("", false, true);
  val RunSummary summary = run_suite(suite, options);
  require_success(summary);
  return;
}

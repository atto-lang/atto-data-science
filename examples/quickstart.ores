import { mean, variance_sample } from "../src/math/reductions.ores";
import { scale, normalize_l2 } from "../src/math/vector.ores";

pub fnc main() -> Result<void, String> {
  let Array<float> xs = new Array<float>(1.0, 2.0, 3.0, 4.0);

  let Array<float> doubled = scale(xs, 2.0);
  let float avg = mean(doubled)?;
  let float variance = variance_sample(doubled)?;
  let Array<float> unit = normalize_l2(doubled)?;

  // Expected: avg=5, sample variance=6.666..., unit.length=4.
  print(avg);
  print(variance);
  print(unit.length);

  return Ok();
}

define class DenseMatrixF64 as
  pub val int rows;
  pub val int cols;
  pub val List<float> values;
end

fnc count_values(List<float> values): int {
  let int count = 0;
  for const value of values do
    count = count + 1;
  done
  return count;
}

// Checked integer-only shape product: never divide through a float.
// The current Java evaluator maps the '/' operator to double arithmetic.
fnc checked_matrix_element_count(int rows, int cols): Result<int, String> {
  if rows < 0; do
    return Err("matrix row count must be non-negative");
  fi
  if cols < 0; do
    return Err("matrix column count must be non-negative");
  fi
  let int addend = rows;
  let int remaining = cols;
  let int product = 0;
  loop {
    if remaining == 0; do
      break;
    fi
    if remaining % 2 == 1; do
      if addend > 9223372036854775807 - product; do
        return Err("matrix dimension product exceeds signed i64");
      fi
      product = product + addend;
    fi
    remaining = remaining >> 1;
    if remaining > 0; do
      if addend > 9223372036854775807 - addend; do
        return Err("matrix dimension product exceeds signed i64");
      fi
      addend = addend + addend;
    fi
  }
  return Ok(product);
}

pub fnc validate_matrix(DenseMatrixF64 matrix): Result<bool, String> {
  if matrix.rows < 0; do
    return Err("matrix row count must be non-negative");
  fi

  if matrix.cols < 0; do
    return Err("matrix column count must be non-negative");
  fi

  val Result<int, String> expected_count = checked_matrix_element_count(
    matrix.rows, matrix.cols
  );
  if expected_count.is_err(); do
    return Err("matrix dimension product exceeds signed i64");
  fi

  if count_values(matrix.values) != expected_count.unwrap(); do
    return Err("matrix storage length does not match rows * cols");
  fi

  return Ok(true);
}

pub fnc matrix_index(
  DenseMatrixF64 matrix,
  int row,
  int col
): Result<int, String> {
  if row < 0; do
    return Err("row index out of bounds");
  fi
  if row >= matrix.rows; do
    return Err("row index out of bounds");
  fi
  if col < 0; do
    return Err("column index out of bounds");
  fi
  if col >= matrix.cols; do
    return Err("column index out of bounds");
  fi

  // Validate logical shape without iterating over backing values.
  // The fixed-width integer algorithm is independent of matrix size.
  val Result<int, String> expected_count = checked_matrix_element_count(
    matrix.rows, matrix.cols
  );
  if expected_count.is_err(); do
    return Err("matrix dimension product exceeds signed i64");
  fi

  return Ok((row * matrix.cols) + col);
}

pub fnc matrix_get(
  DenseMatrixF64 matrix,
  int row,
  int col
): Result<float, String> {
  val Result<int, String> index_result = matrix_index(matrix, row, col);
  if index_result.is_err(); do
    return Err("matrix index out of bounds");
  fi

  // matrix_index checks logical bounds only. Before dereferencing a storage
  // index, validate that the backing list matches the declared shape.
  val Result<bool, String> storage_valid = validate_matrix(matrix);
  if storage_valid.is_err(); do
    return Err("matrix storage length does not match its shape");
  fi

  return Ok(matrix.values[index_result.unwrap()]);
}

// Allocation-free matrix-vector multiplication. The caller owns the output
// buffer, which is reused in place and returned on success.
pub fnc matvec_into(
  DenseMatrixF64 matrix,
  List<float> vector,
  List<float> mut output
): Result<List<float>, String> {
  val Result<bool, String> matrix_ok = validate_matrix(matrix);
  if matrix_ok.is_err(); do
    return Err("invalid matrix");
  fi

  if count_values(vector) != matrix.cols; do
    return Err("matvec vector length must equal matrix column count");
  fi

  if count_values(output) != matrix.rows; do
    return Err("matvec output buffer length must equal matrix row count");
  fi

  let int row = 0;
  loop {
    if row >= matrix.rows; do
      break;
    fi

    let float total = 0.0;
    let int col = 0;
    loop {
      if col >= matrix.cols; do
        break;
      fi

      val int index = (row * matrix.cols) + col;
      total = total + (matrix.values[index] * vector[col]);
      col = col + 1;
    }

    output[row] = total;
    row = row + 1;
  }

  return Ok(output);
}
